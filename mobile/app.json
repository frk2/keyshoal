{
  "expo": {
    "name": "Keyshoal",
    "slug": "keyshoal",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios"
    ],
    "updates": {
      "enabled": false
    },
    "ios": {
      "bundleIdentifier": "app.keyshoal.vault",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Keyshoal finds nearby Keyshoal replicas and syncs encrypted changes on your local network.",
        "NSBonjourServices": [
          "_keyshoal-v2._tcp"
        ]
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Use your camera to scan a private Keyshoal pairing code.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
