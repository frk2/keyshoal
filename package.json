{
  "name": "keyshoal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/vault",
    "mobile"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "npm run build:desktop && electron build/desktop",
    "build:desktop": "node scripts/build-desktop.mjs",
    "package:linux": "node scripts/package.mjs linux",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "npm run build:desktop && node tests/desktop-smoke.mjs",
    "test:chrome": "npm run build:desktop && node tests/chrome-smoke.mjs",
    "export:ios": "npm -w @keyshoal/mobile run export:ios",
    "test:sync": "npm run build:desktop && node tests/peer-smoke.mjs",
    "package:windows": "node scripts/package.mjs windows"
  },
  "dependencies": {
    "@keyshoal/vault": "0.1.0",
    "bonjour-service": "1.4.4",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.0",
    "@electron/packager": "20.3.0",
    "electron": "45.5.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.1"
  }
}
